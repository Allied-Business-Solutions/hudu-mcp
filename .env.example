# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub - it contains your secret API key

# Your Hudu instance API base URL (no trailing slash)
# Example: https://your-company.huducloud.com/api/v1
HUDU_BASE_URL=https://your-instance.huducloud.com/api/v1

# Your Hudu API key
# Get this from: Hudu Admin → Basic Information → API Keys
HUDU_API_KEY=your_api_key_here
